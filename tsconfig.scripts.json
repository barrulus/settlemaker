{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "scripts/metrics-lib.ts",
    "src/**/*.ts",
    "scripts/review-village-roads.ts",
    "scripts/review-village-landscape.ts",
    "tests/fixtures/village-roads.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
